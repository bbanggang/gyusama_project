# =====================================================================
# gyusama-project — RPi5용 베이스 이미지 (ARM64)
# Base : 공식 ROS2 Jazzy 멀티아키텍처 이미지 사용 (ARM64 지원)
#        → QEMU 에뮬레이션으로 ROS2를 직접 빌드하면 py3compile
#          BrokenPipeError 버그가 발생하므로 공식 이미지를 베이스로 사용
# =====================================================================
FROM ros:jazzy-ros-base

# 비대화형 설치 모드
ENV DEBIAN_FRONTEND=noninteractive

# ── TurtleBot3 + 카메라 + 추론 필수 패키지 설치 ──────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-turtlebot3-msgs \
    ros-jazzy-turtlebot3-bringup \
    ros-jazzy-dynamixel-sdk \
    ros-jazzy-cv-bridge \
    ros-jazzy-camera-ros \
    ros-jazzy-ld08-driver \
    python3-argcomplete \
    python3-pip \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/*

# ── ONNX Runtime + ncnn + numpy 버전 고정 (cv_bridge NumPy 1.x 호환) ──
RUN pip3 install --no-cache-dir --break-system-packages \
    onnxruntime \
    ncnn \
    "numpy<2"

# ── HailoRT 런타임 + Python 바인딩 (Hailo-8 NPU 추론용) ──────────────
# PCIe 드라이버는 호스트 측 DKMS 모듈 사용 (컨테이너에서는 /dev/hailo0 만 마운트)
# 4.23.0 / aarch64 / Python 3.12 (베이스 Ubuntu Noble 매치)
#
# 우회 처리: hailort.postinst가 `if [ ! -f /.dockerenv ]`로 Docker 환경 감지 후
#   systemctl restart hailort.service 호출. buildkit/QEMU 빌드 환경에는
#   /.dockerenv 가 없어 systemctl가 실행되며 exit 127. → 빌드 시 임시로 touch
# wheel 파일명은 pip이 메타데이터({pkg}-{ver}-{py}-{abi}-{platform})로 파싱하므로
# 원본 파일명 그대로 유지 (단순화하면 "not a valid wheel filename" 오류)
COPY docker/hailo/hailort_4.23.0_arm64.deb /tmp/hailort.deb
COPY docker/hailo/hailort-4.23.0-cp312-cp312-linux_aarch64.whl /tmp/hailort-4.23.0-cp312-cp312-linux_aarch64.whl
RUN set -eux \
 && touch /.dockerenv \
 && apt-get update \
 && dpkg -i /tmp/hailort.deb \
 && apt-get install -fy --no-install-recommends \
 && pip3 install --no-cache-dir --break-system-packages \
      /tmp/hailort-4.23.0-cp312-cp312-linux_aarch64.whl \
 && rm -f /tmp/hailort.deb /tmp/hailort-4.23.0-cp312-cp312-linux_aarch64.whl \
 && rm -rf /var/lib/apt/lists/*

# ── ROS2 환경 변수 ────────────────────────────────────────────────────
ENV ROS_DOMAIN_ID=1
ENV TURTLEBOT3_MODEL=burger

# ── 작업 디렉토리 ─────────────────────────────────────────────────────
WORKDIR /ros2_ws

# ── 프로젝트 코드 내장 (빌드 컨텍스트: 프로젝트 루트) ─────────────────
# .dockerignore 로 .pt 파일·학습 스크립트·불필요 디렉토리 제외
COPY models/inference_node/ /ros2_ws/models/inference_node/
COPY models/runs/           /ros2_ws/models/runs/
COPY config/                /ros2_ws/config/

# ── entrypoint: ROS2 환경 자동 소싱 ──────────────────────────────────
# 빌드 컨텍스트가 프로젝트 루트이므로 docker/ 경로 명시
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
